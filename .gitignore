# P2 (webplan) — دادهٔ runtime گرهِ قیمت (HistoryStore/DiskHistoryStore).
# JSONLها هنگامِ اجرا نوشته می‌شوند؛ دادهٔ محیطی است، نه سورس ⇒ commit نمی‌شود.
local-mobile/data/history/
local-mobile/data/

# Telegram-Resource: ویدیوهای آموزشیِ حجیم (غیرقابلِ تحلیلِ متنی) از git حذف می‌شوند
# تا repo سبک بماند؛ محتوایِ متنی/سورس/PDF نگه داشته می‌شود.
Telegram-Resource/**/*.mp4
Telegram-Resource/**/*.ppsx
strategies/_s332_cache/

# S346 — کشِ ویژگیِ بانکِ ۴۰۱ اندیکاتوری (پارتیشن‌های mmap شدهٔ float32).
# اینها **بازتولیدپذیر** با build_parts() هستند و ~۷MB به‌ازای هر کارت اشغال
# می‌کنند ⇒ از git حذف می‌شوند. اما فایل‌های JSON نتیجه (sweep / joint / manifest)
# **یافتهٔ علمی** هستند و باید چک‌پوینت شوند، پس ignore نمی‌شوند.
results/_scan_S346/*.npy
