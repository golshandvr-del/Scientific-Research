__pycache__/
*.pyc
*.log
/tmp/

# web_tool (Node/Cloudflare project)
web_tool/node_modules/
web_tool/dist/
web_tool/.wrangler/
web_tool/.dev.vars

# ابزار توسعه parity (حجیم)
web_tool/tools/full_ref_2000.json
web_tool/tools/full_feats_2000.json
web_tool/dist_parity/
# دادهٔ برابریِ S335 (بازتولیدپذیر با s335_parity_export.py / s335_signal_export.py)
strategies/s335_parity_ref.json
strategies/s344_parity_ref.json
strategies/s335_signal_*.json
.tmp_logs/

# P2 (webplan) — دادهٔ runtime گرهِ قیمت (HistoryStore/DiskHistoryStore).
# JSONLها هنگامِ اجرا نوشته می‌شوند؛ دادهٔ محیطی است، نه سورس ⇒ commit نمی‌شود.
local-mobile/data/history/
local-mobile/data/

# Telegram-Resource: ویدیوهای آموزشیِ حجیم (غیرقابلِ تحلیلِ متنی) از git حذف می‌شوند
# تا repo سبک بماند؛ محتوایِ متنی/سورس/PDF نگه داشته می‌شود.
Telegram-Resource/**/*.mp4
Telegram-Resource/**/*.ppsx
strategies/_s332_cache/

# S346 — کشِ ویژگیِ بانکِ ۴۰۱ اندیکاتوری (پارتیشن‌های mmap شدهٔ float32).
# اینها **بازتولیدپذیر** با build_parts() هستند و ~۷MB به‌ازای هر کارت اشغال
# می‌کنند ⇒ از git حذف می‌شوند. اما فایل‌های JSON نتیجه (sweep / joint / manifest)
# **یافتهٔ علمی** هستند و باید چک‌پوینت شوند، پس ignore نمی‌شوند.
results/_scan_S346/*.npy

# ── ممیزیِ RQS2: فایل‌های خامِ ضبطِ سیگنال ───────────────────────────────────
# `results/_audit_rename/captures/*.json` خروجیِ **میانیِ** هارنسِ ضبط است:
# ایندکسِ هر سیگنال و هندسهٔ هر معامله. برای لایه‌های جاروبِ پارامتری این
# فایل به ۱۰۵MB می‌رسد و سقفِ ۱۰۰MB گیت‌هاب را می‌شکند (اندازه‌گیری‌شده روی
# `s166_mtf_rescue`: پوش رد شد).
#
# حذفشان بی‌خطر است چون:
#   ۱) کاملاً **بازتولیدپذیر**اند: `python tools/audit_capture.py <script>`
#   ۲) **یافتهٔ علمی نیستند**؛ یافته، حکمِ RQS2 است که در
#      `results/_audit_rename/verdicts/*.json` (کوچک) چک‌پوینت می‌شود.
#   ۳) نامِ نهاییِ فایلِ لایه و `AUDIT_LEDGER.json` هر دو ردیابی می‌شوند.
results/_audit_rename/captures/*.json

# لاگِ اجراییِ موتورِ ممیزی — خروجیِ کنسول است، نه یافتهٔ علمی. اگر ردیابی
# شود، `git add -A results/` داخلِ خودِ موتور آن را وسطِ نوشتن کامیت می‌کند
# و کامیت‌های چک‌پوینت را آلوده و غیرقابلِ بازخوانی می‌سازد.
results/_audit_rename/batch.log

# ────────────────────────────────────────────────────────────────────────
# S434 — دادهٔ کاملِ MT5 (۱۹ تایم‌فریمِ طلا، ۵۷۳MB خام)
# ────────────────────────────────────────────────────────────────────────
# چرا نادیده گرفته می‌شود: ۵۷۳ مگابایت CSV، مخزن را برای هر clone و هر push
# سنگین می‌کند و «چرخهٔ چک‌پوینتِ بعد از هر تغییرِ فایل» را — که قانونِ
# غیرقابل‌مذاکرهٔ این پروژه است — عملاً فلج می‌کند.
# چرا از دست نمی‌رود: `tools/s434_fetch_mt5_full.py` + مانیفستِ SHA256 در
# `data/mt5_full/MANIFEST.json` کامیت می‌شوند، پس هر AI دیگری می‌تواند
# بیت‌به‌بیت همین داده را بازتولید و **تأیید** کند.
data/mt5_full/*.csv
